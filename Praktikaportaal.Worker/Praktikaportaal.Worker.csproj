<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The Worker is a separate process that talks to the system ONLY through the HTTP API.
    It deliberately references neither Praktikaportaal.Core nor Praktikaportaal.Infrastructure
    (no DbContext, no shared services) - it has its own small DTOs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Praktikaportaal.Worker-07be2be6-543b-4bcf-bdab-f03696fe010b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>
</Project>
