@model Praktikaportaal.Web.Models.RegisterCompanyViewModel
@{
    ViewData["Title"] = "Ettevõtte registreerimine";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 my-4">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-2 text-center">Ettevõtte registreerimine</h3>
                <p class="text-muted text-center mb-4 small">Registreeri ettevõte ja paku praktikakohti tulevastele arendajatele</p>

                <form asp-action="RegisterCompany" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <h5 class="fw-bold text-primary mb-3">Ettevõtte andmed</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="CompanyName" class="form-label fw-semibold">Ettevõtte ärinimi *</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Acme Software OÜ" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RegistrationCode" class="form-label fw-semibold">Registrikood *</label>
                            <input asp-for="RegistrationCode" class="form-control" placeholder="12345678" />
                            <span asp-validation-for="RegistrationCode" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Lühitutvustus</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Ettevõtte tegevusvaldkond ja tutvustus..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label fw-semibold">Veebileht</label>
                            <input asp-for="Website" class="form-control" placeholder="https://example.ee" />
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Aadress / Kontor</label>
                            <input asp-for="Address" class="form-control" placeholder="Lõõtsa 8, Tallinn" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary mb-3">Kontaktisik ja konto</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Kontaktisiku eesnimi *</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Kontaktisiku perekonnanimi *</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold">E-post (sisselogimiseks) *</label>
                            <input asp-for="Email" class="form-control" placeholder="hr@example.ee" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Parool *</label>
                            <input asp-for="Password" class="form-control" placeholder="Vähemalt 6 tähemärki" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Korda parooli *</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label fw-semibold">Kontakttelefon</label>
                            <input asp-for="ContactPhone" class="form-control" placeholder="+372 5..." />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label fw-semibold">Üldine kontakt-e-post</label>
                            <input asp-for="ContactEmail" class="form-control" placeholder="info@example.ee" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold mt-4">Registreeri ettevõte</button>
                </form>

                <hr class="my-4" />

                <div class="text-center small text-muted">
                    Sul on juba konto? <a asp-action="Login" class="fw-semibold">Logi sisse</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

