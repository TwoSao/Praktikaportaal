@model List<Praktikaportaal.Web.Models.InternshipItemViewModel>
@{
    ViewData["Title"] = "Praktikapakkumised";
    string? search = ViewBag.Search as string;
    bool? isRemote = ViewBag.IsRemote as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Aktiivsed praktikapakkumised</h2>
        <p class="text-muted mb-0">Leia endale sobiv praktika ettevõtetes üle Eesti või kaugtööna</p>
    </div>
    @if (User.IsInRole("Company"))
    {
        <a asp-controller="Company" asp-action="Create" class="btn btn-success">+ Lisa uus kuulutus</a>
    }
</div>

<!-- Search filter bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-7">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Otsi ametinimetuse, tehnoloogia, linna või ettevõtte järgi..." />
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" name="isRemote" value="true" id="isRemoteCheck" @(isRemote == true ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="isRemoteCheck">Ainult kaugtöö</label>
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Otsi</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <div class="fs-1 text-muted mb-3">🔍</div>
        <h4 class="fw-bold">Kuulutusi ei leitud</h4>
        <p class="text-muted">Proovi muuta otsingusõnu või vaata kõiki aktiivseid pakkumisi.</p>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Tühjenda filter</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 card-internship">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border">
                                @(string.IsNullOrEmpty(item.Location) ? "Asukoht määramata" : item.Location)
                            </span>
                            @if (item.IsRemote)
                            {
                                <span class="badge bg-info text-dark">🏠 Kaugtöö</span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-primary mb-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                @item.Title
                            </a>
                        </h5>
                        <h6 class="card-subtitle text-muted mb-3 fw-semibold">@item.CompanyName</h6>

                        <p class="card-text text-muted small flex-grow-1">
                            @(item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description)
                        </p>

                        @if (item.Skills != null && item.Skills.Count > 0)
                        {
                            <div class="mb-3">
                                @foreach (var skill in item.Skills.Take(3))
                                {
                                    <span class="badge bg-secondary me-1">@skill</span>
                                }
                            </div>
                        }

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">
                                @if (item.ApplicationDeadline.HasValue)
                                {
                                    <span>Tähtaeg: @item.ApplicationDeadline.Value.ToString("dd.MM.yyyy")</span>
                                }
                                else
                                {
                                    <span>Tähtajata</span>
                                }
                            </small>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Vaata lähemalt</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

