@model Praktikaportaal.Web.Models.ApplyViewModel
@{
    ViewData["Title"] = "Kandideeri praktikale: " + Model.InternshipTitle;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="mb-3">
            <a asp-action="Details" asp-route-id="@Model.InternshipId" class="text-decoration-none text-muted">&larr; Tagasi kuulutuse juurde</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-1">Kandideerimisavaldus</h3>
                <h5 class="text-primary mb-3">@Model.InternshipTitle &mdash; <span class="text-muted">@Model.CompanyName</span></h5>

                <form asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InternshipId" />
                    <input type="hidden" asp-for="InternshipTitle" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="CoverLetter" class="form-label fw-semibold">
                            Kaaskiri / Motivatsioonikiri
                        </label>
                        <p class="text-muted small">
                            Kirjelda lühidalt, miks see praktika sind huvitab, milliste tehnoloogiatega oled TTHK-s või iseseisvalt töötanud ja millised on sinu tugevused.
                        </p>
                        <textarea asp-for="CoverLetter" class="form-control" rows="8" placeholder="Tere! Soovin kandideerida teie ettevõttesse praktikale, sest..."></textarea>
                        <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Details" asp-route-id="@Model.InternshipId" class="btn btn-outline-secondary">Tühista</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Esita avaldus &rarr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

