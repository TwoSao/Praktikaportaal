@using Praktikaportaal.Core.Enums
@using Praktikaportaal.Web.Services
@model CompanyDashboardViewModel
@{
    ViewData["Title"] = "Töölaud";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="page-title h2 mb-0">Töölaud</h1>
    <div class="d-flex align-items-center gap-3">
        <span id="liveStatus" class="small text-muted" data-ws-path="/ws/applications" title="Uued avaldused ilmuvad siia ilma lehte värskendamata">
            <span class="live-dot"></span><span class="live-text">Ühendan…</span>
        </span>
        <a class="btn btn-primary" asp-action="Create">+ Lisa kuulutus</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Kuulutusi kokku</div><div class="value">@Model.Internships.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Avaldatud</div><div class="value">@Model.Published</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Avaldusi kokku</div><div class="value" id="totalApplications">@Model.TotalApplications</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-semibold">Minu kuulutused</div>
            @if (Model.Internships.Count == 0)
            {
                <div class="empty-state">
                    <div class="big">📝</div>
                    <p>Sul ei ole veel ühtegi kuulutust.</p>
                    <a class="btn btn-primary" asp-action="Create">Lisa esimene kuulutus</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Kuulutus</th><th>Staatus</th><th>Tähtaeg</th><th class="text-center">Avaldusi</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Internships)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Internships" asp-action="Details" asp-route-id="@i.Id" class="fw-semibold text-decoration-none">@i.Title</a>
                                        <div class="small text-muted">@i.Field@(string.IsNullOrWhiteSpace(i.Location) ? "" : " · " + i.Location)</div>
                                    </td>
                                    <td><span class="badge @i.Status.BadgeClass()">@i.Status.Label()</span></td>
                                    <td class="small">@UiText.Date(i.ApplicationDeadline)</td>
                                    <td class="text-center">
                                        <a asp-action="Applicants" asp-route-id="@i.Id" class="badge rounded-pill bg-primary text-decoration-none" title="Vaata avaldusi">
                                            <span data-applications-count="@i.Id">@i.ApplicationsCount</span>
                                        </a>
                                    </td>
                                    <td class="text-end text-nowrap table-actions">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Applicants" asp-route-id="@i.Id">Avaldused</a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@i.Id">Muuda</a>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Rohkem toiminguid">⋯</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var status in Enum.GetValues<InternshipStatus>().Where(s => s != i.Status))
                                                {
                                                    <li>
                                                        <form asp-controller="Internships" asp-action="SetStatus" asp-route-id="@i.Id" method="post">
                                                            <input type="hidden" name="status" value="@status" />
                                                            <button type="submit" class="dropdown-item">Muuda staatuseks: @status.Label()</button>
                                                        </form>
                                                    </li>
                                                }
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form asp-controller="Internships" asp-action="Delete" asp-route-id="@i.Id" method="post">
                                                        <button type="submit" class="dropdown-item text-danger"
                                                                data-confirm="Kas kustutad kuulutuse „@i.Title“? Avaldused säilivad ajaloos.">Kustuta</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-semibold">Uued avaldused (reaalajas)</div>
            <ul class="list-group list-group-flush" id="liveFeed" data-applicants-url="@Url.Action("Applicants", "Company")">
                <li class="list-group-item text-muted small" id="liveFeedEmpty">Siia ilmuvad uued avaldused kohe, kui õppur need esitab.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/live-applications.js" asp-append-version="true"></script>
    <script src="~/js/company-dashboard.js" asp-append-version="true"></script>
}
