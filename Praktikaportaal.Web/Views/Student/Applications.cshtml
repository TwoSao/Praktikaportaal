@using Praktikaportaal.Core.Enums
@using Praktikaportaal.Web.Services
@model StudentApplicationsViewModel
@{
    ViewData["Title"] = "Minu avaldused";
    bool CanWithdraw(ApplicationStatus s) => s is ApplicationStatus.Submitted or ApplicationStatus.Viewed or ApplicationStatus.Interview;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="page-title h2 mb-0">Minu avaldused</h1>
    <form asp-action="Applications" method="get" class="d-flex gap-2 align-items-center">
        <label for="status" class="small text-muted mb-0">Staatus</label>
        <select id="status" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Kõik</option>
            @foreach (var status in Enum.GetValues<ApplicationStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@status.Label()</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-primary">Filtreeri</button></noscript>
    </form>
</div>

@if (Model.Result.Items.Count == 0)
{
    <div class="empty-state">
        <div class="big">📄</div>
        <p>@(Model.Status.HasValue ? "Selle staatusega avaldusi ei ole." : "Sa ei ole veel ühtegi avaldust esitanud.")</p>
        <a class="btn btn-primary" asp-controller="Internships" asp-action="Index">Vaata praktikakohti</a>
        <a class="btn btn-outline-primary" asp-action="Recommendations">Soovitused sulle</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Praktikakoht</th><th>Esitatud</th><th>Staatus</th><th class="text-end"></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Internships" asp-action="Details" asp-route-id="@a.InternshipId" class="fw-semibold text-decoration-none">@a.InternshipTitle</a>
                                <div class="small text-muted">@a.CompanyName</div>
                            </td>
                            <td class="small">@UiText.Date(a.AppliedAt)</td>
                            <td><span class="badge @a.Status.BadgeClass()">@a.Status.Label()</span></td>
                            <td class="text-end table-actions">
                                @if (CanWithdraw(a.Status))
                                {
                                    <form asp-action="Withdraw" asp-route-id="@a.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                data-confirm="Kas võtad avalduse tagasi? Hiljem saad uuesti avalduse esitada.">Võta tagasi</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="new PaginationModel(Model.Result.Page, Model.Result.TotalPages)" />
}
