@model int
<li class="nav-item">
    <a class="nav-link" asp-controller="Notifications" asp-action="Index">
        Teated
        @if (Model > 0)
        {
            <span class="badge rounded-pill bg-danger" id="unreadBadge">@(Model > 99 ? "99+" : Model.ToString())</span>
        }
    </a>
</li>
