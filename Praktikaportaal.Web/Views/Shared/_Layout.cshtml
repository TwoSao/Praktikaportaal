@using System.Security.Claims
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Praktikaportaal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🎓 Praktikaportaal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Ava menüü">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Internships" asp-action="Index">Praktikakohad</a></li>
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Recommendations">Soovitused</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Applications">Minu avaldused</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Profile">Profiil</a></li>
                        }
                        @if (User.IsInRole("Company"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Company" asp-action="Index">Töölaud</a></li>
                            <li class="nav-item"><a class="nav-link text-warning fw-semibold" asp-controller="Company" asp-action="Create">+ Lisa kuulutus</a></li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Statistics">Statistika</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @await Component.InvokeAsync("NotificationBadge")
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-lg-3 text-light small">
                                <span class="badge bg-primary badge-role me-1">@RoleLabel(User.FindFirstValue(ClaimTypes.Role))</span>
                                <span>@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logi välja</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Logi sisse</a>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" id="registerDropdown"
                                        data-bs-toggle="dropdown" aria-expanded="false">Registreeru</button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="registerDropdown">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="RegisterStudent">Õppurina</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="RegisterCompany">Ettevõttena</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 flex-grow-1">
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sulge"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sulge"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    @* Toasts (live notifications etc.) are added here by scripts *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <footer class="border-top py-3 text-muted bg-light mt-auto">
        <div class="container text-center">
            <small>&copy; 2026 Praktikaportaal — Programmeerimine ja hajusrakendused (koolitöö)</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static string RoleLabel(string? role) => role switch
    {
        "Student" => "Õppur",
        "Company" => "Ettevõte",
        "Admin" => "Admin",
        _ => role ?? ""
    };
}
