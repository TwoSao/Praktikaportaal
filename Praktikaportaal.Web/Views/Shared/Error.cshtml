@model ErrorViewModel
@{
    ViewData["Title"] = "Viga";
}
<div class="empty-state">
    <div class="big">⚠️</div>
    <h1 class="h3">Tekkis ootamatu viga</h1>
    <p>Vabandame! Päringut ei õnnestunud töödelda. Proovi mõne hetke pärast uuesti.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Päringu ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Avalehele</a>
</div>
